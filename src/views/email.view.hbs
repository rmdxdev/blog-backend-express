<html
  lang='ru'
  xmlns='http://www.w3.org/1999/xhtml'
  xmlns:v='urn:schemas-microsoft-com:vml'
  xmlns:o='urn:schemas-microsoft-com:office:office'
>
  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=utf-8' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Template</title>
    <!-- <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" /> -->
    <style type='text/css'>
      @media screen and (max-width: 599.98px) { .full-width { width: 100% !important; max-width:
      100% !important; } .mobile-padding { padding-left: 10px !important; padding-right: 10px
      !important; } .mobile-col-padding { padding-left: 0px !important; padding-right: 0px
      !important; } } @media screen and (max-width: 399.98px) { br { display: none !important; }
      .two-columns .column { width: 100% !important; max-width: 100% !important; } .two-columns
      .column img { width: 100% !important; max-width: 100% !important; } .three-columns .column {
      width: 100% !important; max-width: 100% !important; } .three-columns .column img { width: 100%
      !important; max-width: 100% !important; } .four-columns .column { width: 100% !important;
      max-width: 100% !important; } .four-columns .column img { width: 100% !important; max-width:
      100% !important; } }
    </style>
    <!--[if (gte mso 9) | (IE)]>
      <style type="text/css">
        table {
          border-collapse: collapse !important;
        }
      </style>
    <![endif]-->

    <!--[if (gte mso 9) | (IE)]>
      <xml>
        <o:OfficeDocumentSettings>
          <o:AllowPNG />
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    <![endif]-->
  </head>
  <body style='margin: 0; padding: 0; min-width: 100%; background-color: #dde0e1'>
    <!--[if (gte mso 9) | (IE)]>
      <style type="text/css">
        body {
          background-color: #dde0e1 !important;
        }
        body,
        table,
        td,
        p,
        a {
          font-family: sans-serif, Arial, Helvetica !important;
        }
      </style>
    <![endif]-->

    <center
      style='
        width: 100%;
        table-layout: fixed;
        background-color: #dde0e1;
        padding-top: 40px;
        padding-bottom: 40px;
      '
    >
      <div
        style='max-width: 600px; background-color: #dde0e1; box-shadow: 0 0 10px rgba(0, 0, 0, 0.2)'
      >
        <!-- Прехедер -->
        <div
          style='
            font-size: 0;
            line-height: 1px;
            mso-line-height-rule: exactly;
            display: none;
            max-width: 0;
            opacity: 0;
            overflow: hidden;
            mso-hide: all;
          '
        >
          Подтверждение кода
        </div>
        <!--[if (gte mso 9) | (IE)]>
          <table width="600" align="center" border="0" cellpadding="0" cellspacing="0" role="presentation">
          <tr>
          <td>
        <![endif]-->
        <table
          border='0'
          cellpadding='0'
          cellspacing='0'
          role='presentation'
          style="
            border-spacing: 0;
            mso-cellspacing: 0;
            mso-padding-alt: 0;
            background-color: #212e3c;
            color: #565656;
            margin: 0;
            padding: 0;
            max-width: 600px;
            width: 100%;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            border-radius: 6px;
          "
          width='100%'
          bgcolor='#212e3c'
        >
          <!-- Logo -->
          <tr>
            <td style='padding: 0'>
              <table
                width='100%'
                border='0'
                cellpadding='0'
                cellspacing='0'
                style='border-spacing: 0; mso-cellspacing: 0; mso-padding-alt: 0'
              >
                <tr>
                  <td height='20px' style='padding: 0'></td>
                </tr>
                <tr>
                  <td align='center' style='padding: 0'>
                    <h1
                      style='
                        margin: 0;
                        font-weight: 700;
                        font-size: 20px;
                        line-height: normal;
                        color: #bbc4e2;
                      '
                    >
                      Подтверждение кода
                    </h1>
                  </td>
                </tr>
                <tr>
                  <td height='20px' style='padding: 0'></td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- Logo -->

          <!-- Body -->
          <tr>
            <td style='padding: 0'>
              <table
                style='
                  border-spacing: 0;
                  mso-cellspacing: 0;
                  mso-padding-alt: 0;
                  border-bottom: 1px solid #6e86a0;
                  border-top: 1px solid #6e86a0;
                '
                width='100%'
                border='0'
                cellpadding='0'
                cellspacing='0'
              >
                <tr>
                  <td height='40px' style='padding: 0'></td>
                </tr>

                <tr>
                  <td align='center' style='padding: 0'>
                    <p
                      style='
                        margin: 0;
                        font-weight: 400;
                        font-size: 14px;
                        line-height: normal;
                        color: #bbc4e2;
                      '
                    >
                      Здравствуйте!
                    </p>
                  </td>
                </tr>

                <tr>
                  <td height='12px' style='padding: 0'></td>
                </tr>

                <tr>
                  <td align='center' style='padding: 0'>
                    <p
                      style='
                        margin: 0;
                        font-weight: 400;
                        font-size: 14px;
                        line-height: normal;
                        color: #bbc4e2;
                      '
                    >
                      Ваш код подтверждения:
                      <span
                        style='
                          margin: 0;
                          font-weight: 600;
                          font-size: 15px;
                          text-decoration: underline;
                          line-height: normal;
                          color: #6196fb;
                        '
                      >{{code}}</span>
                    </p>
                  </td>
                </tr>

                <tr>
                  <td height='12px' style='padding: 0'></td>
                </tr>

                <tr>
                  <td align='center' style='padding: 0'>
                    <p
                      style='
                        margin: 0;
                        font-weight: 400;
                        font-size: 14px;
                        line-height: normal;
                        color: #bbc4e2;
                      '
                    >
                      Пожалуйста, введите этот код на сайте для завершения процесса верификации
                    </p>
                  </td>
                </tr>

                <tr>
                  <td height='40px' style='padding: 0'></td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- Body -->

          <!-- Footer -->
          <tr>
            <td style='padding: 0'>
              <table
                width='100%'
                border='0'
                cellpadding='0'
                cellspacing='0'
                style='border-spacing: 0; mso-cellspacing: 0; mso-padding-alt: 0'
              >
                <tr>
                  <td height='20px' style='padding: 0'></td>
                </tr>

                <tr>
                  <td align='center' style='padding: 0'>
                    <p
                      style='
                        margin: 0;
                        font-weight: 400;
                        font-size: 13px;
                        line-height: normal;
                        color: #bbc4e2;
                      '
                    >
                      Если вы не запрашивали этот код, пожалуйста, проигнорируйте это сообщение
                    </p>
                  </td>
                </tr>

                <tr>
                  <td height='12px' style='padding: 0'></td>
                </tr>

                <tr>
                  <td align='center' style='padding: 0'>
                    <p
                      style='
                        margin: 0;
                        font-weight: 400;
                        font-size: 13px;
                        line-height: 125%;
                        color: #bbc4e2;
                      '
                    >
                      С уважением,
                    </p>
                  </td>
                </tr>

                <tr>
                  <td align='center' style='padding: 0'>
                    <p
                      style='
                        margin: 0;
                        font-weight: 400;
                        font-size: 13px;
                        line-height: 125%;
                        color: #bbc4e2;
                      '
                    >
                      Команда поддержки
                    </p>
                  </td>
                </tr>

                <tr>
                  <td height='20px' style='padding: 0'></td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- Footer -->
        </table>
        <!--[if (gte mso 9) | (IE)]>
          </td>
          </tr>
          </table>
        <![endif]-->
      </div>
    </center>
  </body>
</html>